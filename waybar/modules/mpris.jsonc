{
  "mpris#custom": {
    "ignored-players": ["firefox"],
    "format": "{player_icon} {dynamic}",
    "rotate": 0,
    "on-scroll-up": "hyde-shell volumecontrol -p playerctld i",
    "on-scroll-down": "hyde-shell volumecontrol -p playerctld d",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": {
      "default": "\u25b6",
      "mpv": "\ud83c\udfb5"
    },
    "status-icons": {
      "paused": "\uf04c"
    },
    "max-length": 1000,
    "interval": 1
  }
}
